{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "bun run prepare:sidecars:release",
    "beforeDevCommand": "bun run prepare:sidecars",
    "devPath": "..",
    "distDir": "..",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Converters",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "all": true
      },
      "path": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/icon.ico"
      ],
      "externalBin": [
        "bin/google-ai-studio-json-converter",
        "bin/cherry-studio-backup-json-converter",
        "bin/qwen-json-converter"
      ],
      "identifier": "com.openai.converters"
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Converters",
        "width": 880,
        "height": 640,
        "resizable": true,
        "fullscreen": false,
        "fileDropEnabled": true
      }
    ]
  }
}
